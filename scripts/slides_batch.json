  {
    "op": "add-textbox",
    "slide": "SLIDE_2",
    "text": "No Direct DB Access",
    "x": 45,
    "y": 120,
    "width": 185,
    "height": 24,
    "font_size": 16,
    "bold": true,
    "color": "#0F172A",
    "font_family": "Roboto"
  },
  {
    "op": "add-textbox",
    "slide": "SLIDE_2",
    "text": "\u2022 The LLM acts strictly as an orchestrator.\n\u2022 Never receives SQL connections, ORM models, or DB credentials.\n\u2022 All actions are proposed via explicitly typed, controlled tools.\n\u2022 Backend REST APIs validate and execute all state changes.",
