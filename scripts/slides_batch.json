  },
  {
    "op": "add-textbox",
    "slide": "SLIDE_2",
    "text": "Backend Enforcement",
    "x": 265,
    "y": 120,
    "width": 185,
    "height": 24,
    "font_size": 16,
    "bold": true,
    "color": "#0F172A",
    "font_family": "Roboto"
  },
  {
    "op": "add-textbox",
    "slide": "SLIDE_2",
    "text": "\u2022 Backend validates all inputs, invariants, time conflicts, and authorization.\n\u2022 Never rely on LLM prompts to enforce healthcare rules.\n\u2022 Explicit affirmative confirmation is required before any booking or cancellation.\n\u2022 Atomic transactions prevent slot double-booking.",
    "x": 265,
    "y": 150,
    "width": 185,
    "height": 215,
    "font_size": 11,
    "color": "#334155",
    "font_family": "Roboto",
