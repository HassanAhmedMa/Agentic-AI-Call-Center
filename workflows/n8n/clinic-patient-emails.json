{
  "name": "Clinic Patient Emails",
  "nodes": [
    {
      "id": "patient-email-webhook",
      "name": "Patient Email Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        240
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "clinic-patient-email",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "clinic-patient-email",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_HEADER_CREDENTIAL_ID",
          "name": "Clinic Webhook Header"
        }
      },
      "notes": "Select Header Auth credential with header X-Clinic-Webhook-Key. Do not use the browser or agent to call this endpoint."
    },
    {
      "id": "validate-email-request",
      "name": "Validate Email Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        240
      ],
      "parameters": {
        "jsCode": "// Delivery validation only. OTP generation and verification stay in the backend.\nconst body = $input.first().json.body;\nconst invalid = () => [{ json: { valid: false } }];\nif (!body || typeof body !== 'object' || Array.isArray(body)) return invalid();\nif (Object.keys(body).length !== 3 || !['recipient', 'subject', 'body'].every(k => typeof body[k] === 'string')) return invalid();\nconst recipient = body.recipient.trim();\nif (recipient.length > 254 || !/^[^\\s@,;<>]+@[^\\s@,;<>]+\\.[^\\s@,;<>]+$/.test(recipient)) return invalid();\nif (!body.subject.trim() || body.subject.length > 200 || /[\\x00-\\x1f\\x7f]/.test(body.subject)) return invalid();\nif (!body.body.trim() || body.body.length > 4000 || body.body.includes('\\u0000')) return invalid();\nreturn [{ json: { valid: true, recipient, subject: body.subject, body: body.body } }];\n"
      }
    },
    {
      "id": "request-is-valid",
      "name": "Request Is Valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        240
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "request-valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "send-patient-email",
      "name": "Send Patient Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        720,
        100
      ],
      "parameters": {
        "resource": "email",
        "operation": "send",
        "fromEmail": "noreplydeveloperportal@gmail.com",
        "toEmail": "={{ $json.recipient }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.body }}",
        "options": {
          "appendAttribution": false,
          "allowUnauthorizedCerts": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_SMTP_CREDENTIAL_ID",
          "name": "Clinic Gmail SMTP"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": false,
      "notes": "Gmail SMTP with App Password, not the account login password. Port 587 uses STARTTLS; leave implicit SSL/TLS disabled and STARTTLS enabled."
    },
    {
      "id": "email-accepted",
      "name": "Email Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        980,
        40
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\": \"accepted\"}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "email-delivery-failed",
      "name": "Email Delivery Failed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        980,
        200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"error\": \"EMAIL_DELIVERY_FAILED\"}",
        "options": {
          "responseCode": 502
        }
      }
    },
    {
      "id": "invalid-request",
      "name": "Invalid Request",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        720,
        400
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"error\": \"INVALID_EMAIL_REQUEST\"}",
        "options": {
          "responseCode": 400
        }
      }
    },
    {
      "id": "review-before-publishing",
      "name": "Review Before Publishing",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -120
      ],
      "parameters": {
        "content": "## Clinic Patient Emails — review draft\nBackend owns OTP generation, expiry and verification.\nThis workflow only delivers Arabic/English plain-text emails.\nSelect both credentials before publishing. No secrets in this JSON.\nExecution payload saving is disabled: do not pin real patient/OTP data.\nSMTP acceptance does not guarantee inbox arrival.",
        "height": 270,
        "width": 1150
      }
    }
  ],
  "connections": {
    "Patient Email Webhook": {
      "main": [
        [
          {
            "node": "Validate Email Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Email Request": {
      "main": [
        [
          {
            "node": "Request Is Valid",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Request Is Valid": {
      "main": [
        [
          {
            "node": "Send Patient Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Invalid Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Patient Email": {
      "main": [
        [
          {
            "node": "Email Accepted",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Email Delivery Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 30,
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "saveExecutionProgress": false
  },
  "pinData": {},
  "tags": []
}
