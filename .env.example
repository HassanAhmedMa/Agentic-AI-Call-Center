# ==============================================================================
# Agentic Clinic - Environment Configuration Template (.env.example)
#
# Copy this file to .env before starting local development:
#   cp .env.example .env
#
# IMPORTANT:
# - NEVER commit the actual .env file or any real secrets to the repository.
# - All keys below use dummy/placeholder values for documentation purposes.
# ==============================================================================

# ------------------------------------------------------------------------------
# General System & Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=info
APP_SECRET=change-me-to-a-secure-random-value-in-production

# ------------------------------------------------------------------------------
# Clinic Backend API
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Patient authentication uses server-side bindings, not JWTs.
AGENT_SERVICE_TOKEN=replace-with-at-least-32-random-bytes
VERIFICATION_PROVIDER=smtp
# mock provider is allowed ONLY in development/test, for seeded test accounts.
OTP_HMAC_SECRET=replace-with-a-different-random-secret
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_MAX_SENDS_PER_IDENTITY=3
OTP_SEND_WINDOW_SECONDS=900
OTP_SEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_IP=10
OTP_IP_WINDOW_SECONDS=3600
OTP_MAX_SENDS_PER_CONVERSATION=5
OTP_MAX_FAILURES_PER_IP=20
REGISTRATION_MAX_PER_IP_PER_DAY=3
PUBLIC_REQUESTS_PER_MINUTE=60
CONVERSATIONS_MAX_PER_IP_PER_HOUR=10
TRUSTED_PROXIES=
BROWSER_ALLOWED_ORIGINS=http://localhost:3000
CONVERSATION_RESUME_SECONDS=300
PATIENT_SESSION_IDLE_SECONDS=900
PATIENT_SESSION_ABSOLUTE_SECONDS=3600
IDEMPOTENCY_TTL_SECONDS=86400
CLINIC_TIMEZONE=Africa/Cairo
# Structural slot length/grid requires a migration to change.
BOOKING_MIN_LEAD_MINUTES=60
BOOKING_HORIZON_DAYS=30
APPOINTMENT_CHANGE_NOTICE_HOURS=4
MAX_ACTIVE_APPOINTMENTS_PER_DAY=2
MAX_ACTIVE_APPOINTMENTS=5
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=clinic@example.test
# From a backend container use SMTP_HOST=mailpit and SMTP_PORT=1025.
# Mailpit captures mail locally; it does NOT deliver to a real inbox.

# ------------------------------------------------------------------------------
# Database & Cache (PostgreSQL & Redis)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://clinic_user:clinic_password@localhost:5432/clinic_db
DB_POOL_MIN=2
DB_POOL_MAX=10

REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# AI Agent & LLM Orchestration
# ------------------------------------------------------------------------------
# Replaceable LLM provider abstraction (e.g. openai, anthropic, google, local)
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ------------------------------------------------------------------------------
# RAG & Knowledge Retrieval (Vector DB & Embeddings)
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DB_TYPE=embedded
VECTOR_DB_URL=
VECTOR_DB_API_KEY=your-vector-db-api-key-if-applicable

# ------------------------------------------------------------------------------
# Voice & Audio Processing Layer
# ------------------------------------------------------------------------------
# Replaceable voice provider abstraction (e.g. realtime_api, stt_tts_pipeline)
VOICE_PROVIDER=stt_tts_pipeline
VOICE_API_KEY=your-voice-provider-api-key-here
STT_PROVIDER=whisper
TTS_PROVIDER=elevenlabs
TTS_VOICE_ID=clinic_assistant_ar_en
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# ------------------------------------------------------------------------------
# Clinic API Client (Used by AI Agent Tools)
# ------------------------------------------------------------------------------
CLINIC_API_BASE_URL=http://localhost:8000/api/v1
CLINIC_API_TIMEOUT_SECONDS=5
