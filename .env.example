# ==============================================================================
# Agentic Clinic - Environment Configuration Template (.env.example)
#
# Copy this file to .env before starting local development:
#   cp .env.example .env
#
# IMPORTANT:
# - NEVER commit the actual .env file or any real secrets to the repository.
# - All keys below use dummy/placeholder values for documentation purposes.
# ==============================================================================

# ------------------------------------------------------------------------------
# General System & Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=info
APP_SECRET=change-me-to-a-secure-random-value-in-production

# ------------------------------------------------------------------------------
# Clinic Backend API
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
JWT_SECRET=change-me-jwt-secret-key-32-chars-minimum

# ------------------------------------------------------------------------------
# Database & Cache (PostgreSQL & Redis)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://clinic_user:clinic_password@localhost:5432/clinic_db
DB_POOL_MIN=2
DB_POOL_MAX=10

REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# AI Agent & LLM Orchestration
# ------------------------------------------------------------------------------
# Replaceable LLM provider abstraction (e.g. openai, anthropic, google, local)
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ------------------------------------------------------------------------------
# RAG & Knowledge Retrieval (Vector DB & Embeddings)
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DB_TYPE=qdrant
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_API_KEY=your-vector-db-api-key-if-applicable

# ------------------------------------------------------------------------------
# Voice & Audio Processing Layer
# ------------------------------------------------------------------------------
# Replaceable voice provider abstraction (e.g. realtime_api, stt_tts_pipeline)
VOICE_PROVIDER=stt_tts_pipeline
VOICE_API_KEY=your-voice-provider-api-key-here
STT_PROVIDER=whisper
TTS_PROVIDER=elevenlabs
TTS_VOICE_ID=clinic_assistant_ar_en
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# ------------------------------------------------------------------------------
# Clinic API Client (Used by AI Agent Tools)
# ------------------------------------------------------------------------------
CLINIC_API_BASE_URL=http://localhost:8000/api/v1
CLINIC_API_TIMEOUT_SECONDS=5
