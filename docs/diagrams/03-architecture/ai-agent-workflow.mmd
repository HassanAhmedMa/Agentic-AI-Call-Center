%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#ffffff', 'primaryTextColor': '#000000', 'primaryBorderColor': '#000000', 'lineColor': '#000000', 'secondaryColor': '#ffffff', 'tertiaryColor': '#ffffff', 'background': '#ffffff'}}}%%
flowchart TD
    subgraph WorkflowCanvas [" AI Agent Conversational Control Flow & Workflow "]
        Start(["● Session Initialized"]) --> Idle["Idle: Awaiting Input"]
        Idle --> Receive["Receive Inbound Utterance\n(Voice Stream / Chat Text)"]
        
        Receive --> SafetyCheck{"Safety Rule Check\n(Predefined Keywords?)"}
        
        SafetyCheck -->|Emergency / Urgent Match| Handoff["Trigger Predefined Safety Escalation\n(transfer_to_human)"]
        Handoff --> Advisory["Play Non-Clinical Advisory & Alert Staff"]
        Advisory --> EndHandoff(["Transferred to Human Staff"])

        SafetyCheck -->|Normal Operational Request| IntentClass{"Classify Intent Category"}
        
        IntentClass -->|Policy / FAQ / Hours| RAG["Invoke RAG Service\n(Retrieve Context Chunks)"]
        RAG --> FormulateAnswer["Synthesize Grounded Answer"]
        FormulateAnswer --> SendReply["Send Response to User\n(Voice Audio / Text)"]
        
        IntentClass -->|Out of Clinical Scope| Refuse["Formulate Boundary Refusal\n(Explain Scope Politely)"]
        Refuse --> SendReply

        IntentClass -->|Appointment / Ticket Action| SlotCheck{"Check Mandatory Slots\n(Date, Doctor, Specialty)"}
        
        SlotCheck -->|Missing Information| AskClarify["Prompt User for Missing Details\n('Which date do you prefer?')"]
        AskClarify --> SendReply
        
        SlotCheck -->|All Slots Extracted| MutCheck{"State Mutation Action?\n(Book, Cancel, Reschedule)"}
        
        MutCheck -->|Yes: Requires Confirmation| AskConfirm["Ask User Explicit Confirmation\n('Confirm booking Dr. Sarah at 2 PM?')"]
        AskConfirm --> UserConfirm{"User Decision"}
        
        UserConfirm -->|Declined / Cancel| AbortAction["Abort Mutation & Await Request"]
        AbortAction --> SendReply

        UserConfirm -->|Confirmed| ExecTool["Dispatch Tool via REST API\n(Clinic Backend Verification)"]
        MutCheck -->|No: Read-Only Tool| ExecTool

        ExecTool --> BackendResult{"Backend HTTP Status"}
        
        BackendResult -->|200 / 201 Success| FormatSuccess["Synthesize Confirmation Message\n(Include Booking Code)"]
        FormatSuccess --> SendReply

        BackendResult -->|409 Conflict / Error| HandleError["Catch Conflict (Slot Taken)\n& Query Next Available Slots"]
        HandleError --> SuggestAlternative["Offer Alternative Slots to User"]
        SuggestAlternative --> SendReply

        SendReply --> NextTurn{"User Continues?"}
        NextTurn -->|Yes| Idle
        NextTurn -->|No: Goodbye| SessionEnd(["● Conclude Session"])
    end
    style WorkflowCanvas fill:#ffffff,stroke:#000000,stroke-width:2px
